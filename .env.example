AIRFLOW_UID=50000

# ----- Bitkub Pump Radar (ดู README.md) -----
# Bitkub Public API ฟรี ไม่ต้องใช้ key
# เก็บกี่เหรียญ (คู่ THB ที่ volume 24 ชม. สูงสุด ไม่นับ stablecoin)
BITKUB_TOP_N=50
# ดึงย้อนหลังกี่วันตอนรันครั้งแรก (365 วัน x 50 เหรียญ ≈ 15 ล้านแถว, ~10 นาที)
BITKUB_BACKFILL_DAYS=365
# RAM สูงสุดของ DuckDB ต่อ task (Docker Desktop มี ~4 GB) เกินแล้ว spill ลงดิสก์
DUCKDB_MEMORY_LIMIT=1GB
